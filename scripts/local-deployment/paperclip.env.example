NODE_ENV=production
PAPERCLIP_HOME=/var/lib/paperclip
PAPERCLIP_INSTANCE_ID=production
PAPERCLIP_DISABLE_CWD_ENV_FILE=true
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_BIND=loopback
PORT=3100
SERVE_UI=true
# Consumer subscriptions do not support third-party Antigravity wrapping.
PAPERCLIP_ANTIGRAVITY_GOOGLE_SIGN_IN_ENABLED=false
PAPERCLIP_AUTH_BASE_URL_MODE=explicit
PAPERCLIP_AUTH_PUBLIC_BASE_URL=https://paperclip.example.invalid
PAPERCLIP_ALLOWED_HOSTNAMES=paperclip.example.invalid
# Complete owner setup locally, then set this to true before exposing the proxy.
PAPERCLIP_AUTH_DISABLE_SIGN_UP=true
# Generate separate secret values on the target machine, outside Git.
# BETTER_AUTH_SECRET=
# PAPERCLIP_AGENT_JWT_SECRET=
# For an existing database, set its connection URL and private socket as needed.
# DATABASE_URL=postgres:///paperclip
# PGHOST=/run/postgresql
